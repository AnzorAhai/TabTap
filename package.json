{
  "name": "tabtap",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build --workspace=packages/shared",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev:guest": "npm run dev --workspace=apps/guest-pwa",
    "dev:admin": "npm run dev --workspace=apps/admin",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node --env-file=apps/api/.env db/migrate.mjs",
    "db:reset-demo": "node --env-file=apps/api/.env db/reset-test-data.mjs"
  }
}
