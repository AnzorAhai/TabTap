PORT=3000

# postgresql://user:password@host/dbname?sslmode=require (e.g. from Neon or Supabase)
DATABASE_URL=

# used by the admin panel to build guest QR links
GUEST_APP_URL=http://localhost:5173

# mock (default, no external account needed) | later: iiko | rkeeper | ...
POS_CONNECTOR_TYPE=mock

# mock (default, settles instantly) | stripe
PAYMENT_PROVIDER_TYPE=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
