# Copy to apps/api/.env for local development. On a server, set these as real
# environment variables instead (they always win over values in .env).

# development | production | test
NODE_ENV=development
PORT=3000

# Local without Docker (npm run db:local): postgresql://postgres:postgres@localhost:5433/tabtap
# Local with Docker (docker compose up -d): postgresql://tabtap:tabtap@localhost:5432/tabtap
# Supabase: Project Settings -> Database -> Connection string (session pooler, port 5432)
DATABASE_URL=

# Comma-separated browser origins allowed to call the API.
# Optional in development (defaults to the local Vite ports 5173/5174), required in production.
CORS_ORIGINS=

# Guest app base URL, used to build the table QR links shown in the admin panel.
GUEST_APP_URL=http://localhost:5173

# Bearer token for admin changes (e.g. POST /admin/exchange-rates), until staff
# accounts exist. At least 32 characters: `openssl rand -hex 32`. Unset = disabled.
ADMIN_API_TOKEN=

# Minutes a started payment holds its items/shares before releasing them (default 10).
PAYMENT_HOLD_MINUTES=

# Requests per minute per client IP (default 300). RATE_LIMIT_ENABLED=false turns it off.
RATE_LIMIT_PER_MINUTE=
RATE_LIMIT_ENABLED=

# Releases expired holds and delivers POS updates every few seconds (default true).
BACKGROUND_JOBS=

# mock (default, in-memory demo POS with three Venezuelan bills)
POS_CONNECTOR_TYPE=mock

# mock (default, no real money) | stripe
PAYMENT_PROVIDER_TYPE=mock
# mock only: instant (settles at once) | manual (stays pending until
# POST /payments/:id/mock-confirm — like Pago Móvil, confirmed in the bank app)
MOCK_PAYMENT_FLOW=instant
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
